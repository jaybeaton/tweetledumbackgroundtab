{
	"name": "Tweetledum Background Tab",
	"version": "0.14",
	"manifest_version": 2,
	"description": "Open Tweetledum Links in Background Tab using shortcut key",
	"content_scripts": [
		{
			"matches": [
				"*://tweetledum.embiggen.net/*",
				"*://drupal8.home.jaybeaton.com/tweets/tweetledum/tweetledum/*",
				"*://*.jaybeaton.com/*",
				"*://*.embiggen.net/*"
			],
			"js": ["js/keypress.js"]
		}
	],
	"background": { "scripts": ["js/background.js"] },
	"options_page": "options.html",
	"permissions": [
		"http://tweetledum.embiggen.net/*",
		"https://tweetledum.embiggen.net/*",
		"https://tweetledummer.embiggen.net/*",
                "https://testing.home.jaybeaton.com/*",
		"http://drupal8.home.jaybeaton.com/tweets/tweetledum/tweetledum/*",
	    "storage"
	],
	"minimum_chrome_version": "21",
	"icons": { "128": "images/icon_128.png" }
}
